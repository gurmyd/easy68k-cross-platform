*-----------------------------------------------------------------------------
* @item sim-core 3.16 JMP and JSR through every control mode, RTS and RTR
* Generated by tests/conformance/sim/generate-instructions.mjs - do not edit.
*-----------------------------------------------------------------------------
    ORG     $1000
START:
    JSR     DMP_OPEN
* LEA     J1_0,A2 / JMP     (A2) / MOVEQ   #1,D3 / J1_0: MOVEQ #2,D4
    MOVE.L  #$000000FF,D0
    MOVE.L  #$00000001,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$1F,CCR
    JSR     DMP_CLRC
    LEA     J1_0,A2
    JMP     (A2)
    MOVEQ   #1,D3
    J1_0: MOVEQ #2,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* JMP     J2_1(PC) / MOVEQ   #1,D3 / J2_1: MOVEQ #3,D4
    MOVE.L  #$58585858,D0
    MOVE.L  #$000080A8,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$14,CCR
    JSR     DMP_CLRC
    JMP     J2_1(PC)
    MOVEQ   #1,D3
    J2_1: MOVEQ #3,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* LEA     J3_2,A2 / MOVEQ   #0,D1 / JMP     0(A2,D1.W) / MOVEQ   #1,D3 / J3_2: MOVEQ #4,D4
    MOVE.L  #$0000007F,D0
    MOVE.L  #$64646464,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$00,CCR
    JSR     DMP_CLRC
    LEA     J3_2,A2
    MOVEQ   #0,D1
    JMP     0(A2,D1.W)
    MOVEQ   #1,D3
    J3_2: MOVEQ #4,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* JMP     J4_3 / MOVEQ   #1,D3 / J4_3: MOVEQ #5,D4
    MOVE.L  #$00007FB5,D0
    MOVE.L  #$CFCFCFCF,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$04,CCR
    JSR     DMP_CLRC
    JMP     J4_3
    MOVEQ   #1,D3
    J4_3: MOVEQ #5,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* JSR     S1_4 / BRA.S   J5_4 / S1_4: MOVE.L (SP),D5 / RTS / J5_4: MOVEQ #6,D4
    MOVE.L  #$000000EC,D0
    MOVE.L  #$EEEEEEEE,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$07,CCR
    JSR     DMP_CLRC
    JSR     S1_4
    BRA.S   J5_4
    S1_4: MOVE.L (SP),D5
    RTS
    J5_4: MOVEQ #6,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* LEA     S2_5,A2 / JSR     (A2) / BRA.S   J6_5 / S2_5: RTS / J6_5: MOVEQ #7,D4
    MOVE.L  #$00008000,D0
    MOVE.L  #$00008000,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$0F,CCR
    JSR     DMP_CLRC
    LEA     S2_5,A2
    JSR     (A2)
    BRA.S   J6_5
    S2_5: RTS
    J6_5: MOVEQ #7,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* PEA     J7_6 / MOVE.W  #$001F,-(SP) / RTR / MOVEQ   #1,D3 / J7_6: MOVEQ #8,D4
    MOVE.L  #$D4D4D4D4,D0
    MOVE.L  #$50505050,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$1F,CCR
    JSR     DMP_CLRC
    PEA     J7_6
    MOVE.W  #$001F,-(SP)
    RTR
    MOVEQ   #1,D3
    J7_6: MOVEQ #8,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
* BSR     S3_7 / BRA.S   J8_7 / S3_7: NOP / RTS / J8_7: MOVEQ #9,D4
    MOVE.L  #$00000001,D0
    MOVE.L  #$00008000,D1
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$05,CCR
    JSR     DMP_CLRC
    BSR     S3_7
    BRA.S   J8_7
    S3_7: NOP
    RTS
    J8_7: MOVEQ #9,D4
    JSR     DMP_REGS
    JSR     DMP_CYC
    JSR     DMP_CLOSE
    SIMHALT
    DS.W    0
PAD DS.B    16                  ; room for MOVEM -(A1) below SCR
SCR DS.B    32
PCREL DC.L  $89ABCDEF,$01234567
    INCLUDE '..\dumplib.X68'
    END     START
