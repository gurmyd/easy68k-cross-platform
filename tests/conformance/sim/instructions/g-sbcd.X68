    MOVE.B  #$72,D1
    LEA     SCR+12,A0
    MOVE    #$08,CCR
    JSR     DMP_CLRC
    SBCD    -(A1),-(A0)
    JSR     DMP_REGS
    JSR     DMP_CYC
    LEA     SCR,A0
    MOVEQ   #16,D0
    JSR     DMP_MEM
    JSR     DMP_CLOSE
    SIMHALT
    DS.W    0
PAD DS.B    16                  ; room for MOVEM -(A1) below SCR
SCR DS.B    32
PCREL DC.L  $89ABCDEF,$01234567
    INCLUDE '..\dumplib.X68'
    END     START
