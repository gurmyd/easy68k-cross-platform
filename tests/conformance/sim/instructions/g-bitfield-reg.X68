    JSR     DMP_REGS
    JSR     DMP_CYC
* BFEXTS  D0{D2:D3},D1
    MOVE.L  #$FFFFFFFF,D0
    MOVE.L  #$0000007F,D1
    MOVE.L  #$00000100,D2
    MOVE.L  #$21B9867A,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #3,D2
    MOVE.L  #23,D3
    MOVE    #$11,CCR
    JSR     DMP_CLRC
    BFEXTS  D0{D2:D3},D1
    JSR     DMP_REGS
    JSR     DMP_CYC
* BFFFO  D0{D2:D3},D1
    MOVE.L  #$00000001,D0
    MOVE.L  #$0000007F,D1
    MOVE.L  #$FFFFFFFE,D2
    MOVE.L  #$FFFFFFF0,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #48,D2
    MOVE.L  #34,D3
    MOVE    #$19,CCR
    JSR     DMP_CLRC
    BFFFO  D0{D2:D3},D1
    JSR     DMP_REGS
    JSR     DMP_CYC
* BFCHG   D0{D2:D3}
    MOVE.L  #$FFFFFFFF,D0
    MOVE.L  #$99AD2335,D1
    MOVE.L  #$7FFFFFFF,D2
    MOVE.L  #$798078A1,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #65,D2
    MOVE.L  #36,D3
    MOVE    #$13,CCR
    JSR     DMP_CLRC
    BFCHG   D0{D2:D3}
    JSR     DMP_REGS
    JSR     DMP_CYC
* BFCLR   D0{D2:D3}
    MOVE.L  #$000000FB,D0
    MOVE.L  #$00000008,D1
    MOVE.L  #$000000FF,D2
    MOVE.L  #$7FFFFFFF,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #33,D2
    MOVE.L  #5,D3
    MOVE    #$1F,CCR
    JSR     DMP_CLRC
    BFCLR   D0{D2:D3}
    JSR     DMP_REGS
    JSR     DMP_CYC
* BFSET   D0{D2:D3}
    MOVE.L  #$EC9C63C5,D0
    MOVE.L  #$000000FF,D1
    MOVE.L  #$FFFFFF4D,D2
    MOVE.L  #$000000F3,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #39,D2
    MOVE.L  #18,D3
    MOVE    #$05,CCR
    JSR     DMP_CLRC
    BFSET   D0{D2:D3}
    JSR     DMP_REGS
    JSR     DMP_CYC
* BFINS   D1,D0{D2:D3}
    MOVE.L  #$000000CD,D0
    MOVE.L  #$AAAAAAAA,D1
    MOVE.L  #$00010000,D2
    MOVE.L  #$FFFFFFFF,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE.L  #64,D2
    MOVE.L  #26,D3
    MOVE    #$1A,CCR
    JSR     DMP_CLRC
    BFINS   D1,D0{D2:D3}
    JSR     DMP_REGS
    JSR     DMP_CYC
    JSR     DMP_CLOSE
    SIMHALT
    DS.W    0
PAD DS.B    16                  ; room for MOVEM -(A1) below SCR
SCR DS.B    32
PCREL DC.L  $89ABCDEF,$01234567
    INCLUDE '..\dumplib.X68'
    END     START
