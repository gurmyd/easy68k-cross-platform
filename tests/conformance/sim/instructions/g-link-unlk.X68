*-----------------------------------------------------------------------------
* @item sim-core 3.16 LINK and UNLK, positive and negative displacement; LINK A7 uses USP in supervisor mode (quirk)
* Generated by tests/conformance/sim/generate-instructions.mjs - do not edit.
*-----------------------------------------------------------------------------
    ORG     $1000
START:
    JSR     DMP_OPEN
* LINK    A2,#-8 / MOVE.L  SP,D2 / UNLK    A2
    MOVE.L  #$95959595,D0
    MOVE.L  #$0000003F,D1
    MOVE.L  #$0000007F,D2
    MOVE.L  #$000000FF,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVEA.L #$31313131,A2
    MOVE    #$10,CCR
    JSR     DMP_CLRC
    LINK    A2,#-8
    MOVE.L  SP,D2
    UNLK    A2
    JSR     DMP_REGS
    JSR     DMP_CYC
* LINK    A2,#0 / MOVE.L  SP,D2 / UNLK    A2
    MOVE.L  #$00000002,D0
    MOVE.L  #$00000000,D1
    MOVE.L  #$000000AD,D2
    MOVE.L  #$8C4C4CA1,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVEA.L #$82828282,A2
    MOVE    #$14,CCR
    JSR     DMP_CLRC
    LINK    A2,#0
    MOVE.L  SP,D2
    UNLK    A2
    JSR     DMP_REGS
    JSR     DMP_CYC
* LINK    A2,#8 / MOVE.L  SP,D2 / UNLK    A2
    MOVE.L  #$A0A0A0A0,D0
    MOVE.L  #$FFFFFFFF,D1
    MOVE.L  #$00007FFF,D2
    MOVE.L  #$00000100,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVEA.L #$A0A0A0A0,A2
    MOVE    #$1E,CCR
    JSR     DMP_CLRC
    LINK    A2,#8
    MOVE.L  SP,D2
    UNLK    A2
    JSR     DMP_REGS
    JSR     DMP_CYC
* LINK    A2,#-32768 / MOVE.L  SP,D2 / UNLK    A2
    MOVE.L  #$05050505,D0
    MOVE.L  #$00FFFFCD,D1
    MOVE.L  #$DFDFDFDF,D2
    MOVE.L  #$00000002,D3
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVEA.L #$FFFFFF57,A2
    MOVE    #$1E,CCR
    JSR     DMP_CLRC
    LINK    A2,#-32768
    MOVE.L  SP,D2
    UNLK    A2
    JSR     DMP_REGS
    JSR     DMP_CYC
    JSR     DMP_CLOSE
    SIMHALT
    DS.W    0
PAD DS.B    16                  ; room for MOVEM -(A1) below SCR
SCR DS.B    32
PCREL DC.L  $89ABCDEF,$01234567
    INCLUDE '..\dumplib.X68'
    END     START
