    JSR     DMP_CYC
    LEA     SCR,A0
    MOVEQ   #16,D0
    JSR     DMP_MEM
* ROXR.W -(A1)
    MOVE.L  #$FFFF0098,D0
    MOVE.L  #$82DE2B4D,D1
    MOVE.L  #$EDB7CEA2,D2
    MOVE.L  #$000000E8,D3
    MOVE.L  #$00010000,SCR+0
    MOVE.L  #$20202020,SCR+4
    MOVE.L  #$69696969,SCR+8
    MOVE.L  #$9D9D9D9D,SCR+12
    LEA     SCR,A0
    LEA     SCR+8,A1
    MOVE    #$0B,CCR
    JSR     DMP_CLRC
    ROXR.W -(A1)
    JSR     DMP_REGS
    JSR     DMP_CYC
    LEA     SCR,A0
    MOVEQ   #16,D0
    JSR     DMP_MEM
    JSR     DMP_CLOSE
    SIMHALT
    DS.W    0
PAD DS.B    16                  ; room for MOVEM -(A1) below SCR
SCR DS.B    32
PCREL DC.L  $89ABCDEF,$01234567
    INCLUDE '..\dumplib.X68'
    END     START
