00001000                            36  
00001000                            37  * print the number
00001000                            38  PRINTN    MACRO
00001000                            39      SECTION     CODE
00001000                            40      MOVEM.L     D0/D1,-(SP)
00001000                            41      IFNC '\1','D1'          if some register other than D1
00001000                            42        MOVE.L    \1,D1       put number to display in D1
00001000                            43      ENDC
00001000                            44      MOVE.B  #3,D0
00001000                            45      TRAP    #15             display number in D1
00001000                            46      MOVEM.L (SP)+,D0/D1
00001000                            47      ENDM
00001000                            48  
00001000                            49  
00001000                            50  * Usage POWER N, P
00001000                            51  * Raises N to the P power
00001000                            52  * Resulting number is in D1
00001000                            53  POWER    MACRO
00001000                            54      MOVEM.L     D0/D2,-(A7) save
00001000                            55      IFNC '\2','D2'
00001000                            56        MOVE.W    \2,D2
00001000                            57      ENDC
00001000                            58      IFNC '\1','D1'          if first param is not D1
00001000                            59        MOVE.W    \1,D1
00001000                            60      ENDC
00001000                            61      IFNC '\1','D0'
00001000                            62        MOVE.W    \1,D0
00001000                            63      ENDC
00001000                            64      WHILE.W D2 <HI> #1 DO.S
00001000                            65        MULU  D0,D1           compute power
00001000                            66        SUB.W #1,D2
00001000                            67      ENDW
00001000                            68      MOVEM.L (A7)+,D0/D2
00001000                            69      ENDM
