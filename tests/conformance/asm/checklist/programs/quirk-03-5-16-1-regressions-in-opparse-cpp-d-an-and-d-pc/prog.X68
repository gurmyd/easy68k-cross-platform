	ORG $1000
TABLE	DC.W 1,2,3,4
PTR	EQU 8
SCORE	EQU 4
	MOVE.W (TABLE,PC,D0.W),D1
	MOVE.W TABLE(PC,D0.W),D1
	MOVE.W (PC,D0.W),D1
	MOVE.W (PC,A1),D2
	MOVE.W ($C,A0),D1
	MOVE.W (PTR,A0),D1
	MOVE.W (SCORE,A0,D1.L),D2
	MOVE.W ($1C,A0),D1
	JMP (TABLE,PC,D1.W)
	LEA (TABLE,PC,D0.L),A0
	BTST #3,(TABLE,PC,D0.W)
	MOVE.W (SCORE,PC),D0
	MOVE.W PTR(A0),D0
	END $1000
