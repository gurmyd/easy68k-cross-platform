{
  "name": "easy68k-mac",
  "version": "0.0.0",
  "private": true,
  "description": "EASy68K - unofficial web and macOS port of the EASy68K v5.16.1 68000 editor/assembler and simulator",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "app",
    "desktop",
    "tests"
  ],
  "scripts": {
    "postinstall": "node tools/install-electron.mjs",
    "setup:emsdk": "node -e \"const w = process.platform === 'win32'; const r = require('node:child_process').spawnSync(w ? 'powershell' : 'sh', w ? ['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', 'tools/setup-emsdk.ps1'] : ['tools/setup-emsdk.sh'], { stdio: 'inherit' }); process.exit(r.status ?? 1)\"",
    "build:engines": "node tools/build-engines.mjs",
    "fetch:engines": "node tools/fetch-engines.mjs",
    "dev": "npm run dev --workspace app --",
    "build": "npm run build --workspace app --",
    "preview": "npm run preview --workspace app --",
    "typecheck": "node tools/typecheck.mjs",
    "lint": "eslint . && vitest run --root tests/lint --testTimeout=30000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace app --",
    "test:conformance": "vitest run --config tests/vitest.workspace.ts",
    "test:integration": "vitest run --config tests/vitest.integration.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts --pass-with-no-tests",
    "test:all": "npm test && npm run test:conformance && npm run test:integration && npm run test:e2e",
    "check:gallery": "node app/src/ui/components/gallery/check-gallery.mjs",
    "check:shell": "node app/src/ui/shell/check-shell.mjs",
    "check:engine-browsers": "node tools/check-engine-browsers.mjs",
    "check:editor": "node app/src/ui/editor/check-editor.mjs",
    "check:highlight": "node app/src/features/highlight/check-highlight.mjs",
    "check:files": "node app/src/features/files/check-files.mjs",
    "check:documents": "node app/src/features/documents/check-documents.mjs",
    "check:help": "node app/src/features/help/check-help.mjs",
    "check:surface": "node app/src/core/sim-host/surface/check-surface.mjs",
    "check:easybin": "node app/src/features/easybin/check-easybin.mjs",
    "check:memory-stack": "node app/src/features/memory/check-memory-stack.mjs",
    "check:text": "node app/src/core/sim-host/text/check-text.mjs",
    "check:output": "node app/src/features/output/check-output.mjs",
    "check:hardware": "node app/src/features/hardware/check-hardware.mjs",
    "check:stop-buttons": "node tests/conformance/sim/check-stop-buttons.mjs",
    "check:run": "node app/src/features/run/check-run.mjs",
    "check:sim-main": "node app/src/features/sim-main/check-sim-main.mjs",
    "check:pwa": "node app/src/features/pwa/check-pwa.mjs",
    "check:wave1": "node tests/integration/wave1/check-wave1.mjs",
    "check:options": "node app/src/features/options/check-options.mjs",
    "check:find": "node app/src/features/find/check-find.mjs",
    "check:print": "node app/src/features/print/check-print.mjs",
    "check:fsaccess": "node app/src/features/files-fsaccess/check-fsaccess.mjs",
    "check:assemble": "node app/src/features/assemble/check-assemble.mjs",
    "check:audio": "node app/src/features/audio/check-audio.mjs",
    "check:sim-files": "node app/src/features/sim-files/check-sim-files.mjs",
    "check:breakpoints": "node app/src/features/breakpoints/check-breakpoints.mjs",
    "check:log": "node app/src/features/log/check-log.mjs",
    "check:wave2": "node tests/integration/wave2/check-wave2.mjs",
    "check:examples": "node tests/conformance/examples/check-examples.mjs",
    "check:desktop-devices": "node app/src/features/desktop-devices/check-desktop-devices.mjs",
    "check:a11y": "node tests/a11y/check-a11y.mjs",
    "check:perf": "node tests/perf/check-perf.mjs",
    "check:docs": "node --test tools/check-docs.test.mjs",
    "test:check-ending": "node --test tests/browser-checks/ending.test.mjs",
    "check:rc": "node tests/integration/rc/rc.mjs",
    "oracle:wine:build": "docker build -t easy68k-oracle-wine tests/oracle/wine",
    "oracle:wine:asm": "node tests/oracle/wine/asm/regenerate.mjs",
    "oracle:wine:sim": "node tests/oracle/wine/sim/regenerate.mjs",
    "oracle:gdi": "node tests/oracle/gdi-capture/run.mjs",
    "oracle:twins": "node tests/oracle/native-twin/run.mjs",
    "import:help": "node tools/import-help.mjs",
    "import:examples": "node tools/import-examples.mjs",
    "desktop:dev": "node tools/desktop-dev.mjs",
    "desktop:pack": "npm run build --workspace app && npm run pack --workspace desktop",
    "desktop:dist": "npm run build --workspace app && npm run dist --workspace desktop --",
    "desktop:test": "node tools/desktop-test.mjs",
    "fonts:atlases": "node tools/make-font-atlases.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "electron-winstaller": false
  }
}
