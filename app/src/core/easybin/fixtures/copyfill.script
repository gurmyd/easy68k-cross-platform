# Copy and Fill (docs/porting/easybin.md 14).
reset
loadbin bin256.BIN 001000 0
copy 001000 001001 000010
dump 001000 20
copy 001010 001008 000010
dump 001000 32
copy 001000 001000 000010
copy 001000 002000 000000
copy 001000 FFFFF8 000010
dump FFFFF0 16
copy FFFFF8 000100 000010
dump 000100 16
copy FFFFF0 FFFFF8 000008
dump FFFFF0 16
fill 002000 00200F 00
dump 001FFE 20
fill 003000 002000 11
fill FFFFF0 FFFFFF 77
dump FFFFF0 16
fill 000000 000000 1
digest
