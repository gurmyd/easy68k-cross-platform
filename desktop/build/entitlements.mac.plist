<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for a Developer ID signature with the hardened runtime (section 11 of
  docs/ARCHITECTURE.md). Used only when release.yml finds the optional signing secrets; the default
  ad-hoc signature (7.6) has no hardened runtime and no entitlements.

  V8 compiles JavaScript and WebAssembly at run time, which the hardened runtime forbids unless these
  two are granted. Nothing else is asked for: the app needs no camera, microphone, network server or
  Apple events. Owner: DV3.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
